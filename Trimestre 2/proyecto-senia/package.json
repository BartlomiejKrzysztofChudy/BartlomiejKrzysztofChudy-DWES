{
  "name": "proyecto-notas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js api",
    "console": "node src/index.js cli",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "sonar": "sonar-scanner",
    "sonar:local": "powershell -ExecutionPolicy Bypass -File scripts/sonar-local.ps1",
    "sonar:docker": "powershell -ExecutionPolicy Bypass -File scripts/sonar-docker.ps1",
    "send-email": "node scripts/send-email.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "supertest": "^7.1.4",
    "vitest": "^4.0.15"
  }
}
